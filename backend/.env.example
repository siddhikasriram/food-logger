APP_NAME=food-logger
APP_ENV=development
DEBUG=true

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=foodlogger
MYSQL_PASSWORD=foodlogger
MYSQL_DATABASE=food_logger

DATABASE_URL=mysql+pymysql://foodlogger:foodlogger@localhost:3306/food_logger

# CORS — comma-separated origins the React frontend may call
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
