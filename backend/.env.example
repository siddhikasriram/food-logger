APP_NAME=food-logger
APP_ENV=development
DEBUG=true

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=food_log
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=food_log

DATABASE_URL=mysql+pymysql://food_log:changeme@localhost:3306/food_log

# CORS — comma-separated origins the React frontend may call
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenAI — keep this key on the backend only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
